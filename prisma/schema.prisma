generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id        String     @id @default(uuid())
  nome      String
  cpf       String     @unique
  email     String?
  telefone  String?
  criadoEm  DateTime   @default(now())

  processos Processo[]
}

model Processo {
  id           String    @id @default(uuid())
  numero       String    @unique
  status       String
  descricao    String?
  titulo       String?
  prioridade   String?
  prazo        DateTime?
  tags         Json?
  concluido    Boolean   @default(false)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  compromissos Compromisso[]
  documentos   Documento[]
  conversas    Conversacao[]
}

model Compromisso {
  id         String   @id @default(uuid())
  titulo     String
  descricao  String?
  dataHora   DateTime
  criadoEm   DateTime @default(now())

  processoId String?
  processo   Processo? @relation(fields: [processoId], references: [id], onDelete: Cascade)
}

model Documento {
  id         String   @id @default(uuid())
  nome       String
  urlArquivo String
  tamanho    Int?
  criadoEm   DateTime @default(now())

  processoId String
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
}

model MembroEquipe {
  id       String   @id @default(uuid())
  nome     String
  email    String
  cargo    String
  status   String   @default("active")
  criadoEm DateTime @default(now())
}

model Preferencia {
  id            String   @id @default("default")
  nome          String   @default("")
  email         String   @default("")
  notificacoes  Json     @default("{\"email\":true,\"push\":true,\"reminders\":true,\"teamUpdates\":true}")
  tema          String   @default("light")
  atualizadoEm  DateTime @updatedAt
}

model Conversacao {
  id         String   @id @default(uuid())
  titulo     String
  processoId String?
  processo   Processo? @relation(fields: [processoId], references: [id], onDelete: Cascade)
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  mensagens Mensagem[]
}

model Mensagem {
  id            String   @id @default(uuid())
  conteudo      String
  isUser        Boolean
  criadoEm      DateTime @default(now())

  conversacaoId String
  conversacao   Conversacao @relation(fields: [conversacaoId], references: [id], onDelete: Cascade)
}
