generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id        String     @id @default(uuid())
  nome      String
  cpf       String     @unique
  email     String?
  telefone  String?
  criadoEm  DateTime   @default(now())

  processos Processo[]
}

model Processo {
  id           String    @id @default(uuid())
  numero       String    @unique
  status       String
  descricao    String?
  titulo       String?
  prioridade   String?
  prazo        DateTime?
  tags         Json?
  concluido    Boolean   @default(false)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  compromissos Compromisso[]
  documentos   Documento[]
  conversas    Conversacao[]
}

model Compromisso {
  id         String   @id @default(uuid())
  titulo     String
  descricao  String?
  dataHora   DateTime
  criadoEm   DateTime @default(now())

  processoId String?
  processo   Processo? @relation(fields: [processoId], references: [id], onDelete: Cascade)
}

model Documento {
  id         String   @id @default(uuid())
  nome       String
  urlArquivo String
  tamanho    Int?
  criadoEm   DateTime @default(now())

  processoId String
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
}

model MembroEquipe {
  id       String   @id @default(uuid())
  nome     String
  email    String
  cargo    String
  status   String   @default("active")
  criadoEm DateTime @default(now())
}

enum Role {
  ADMIN
  ADVOGADO
  ASSISTENTE
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  role      Role     @default(ASSISTENTE)
  fotoUrl   String?
  criadoEm  DateTime @default(now())

  preferencia   Preferencia?
  inbox         InboxItem[]
  contatos      ContatoLog[]
  conversacoes  Conversacao[]
}

model Preferencia {
  id                 String   @id @default(uuid())
  usuarioId          String   @unique
  usuario            Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nome               String   @default("")
  email              String   @default("")
  fotoUrl            String?
  notificacoes       Json     @default("{\"email\":true,\"push\":true,\"reminders\":true,\"teamUpdates\":true}")
  notificacoesLidas  Json     @default("[]")
  tema               String   @default("light")
  atualizadoEm       DateTime @updatedAt
}

model InboxItem {
  id         String   @id @default(uuid())
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo     String
  corpo      String
  tipo       String   @default("sistema")
  lida       Boolean  @default(false)
  link       String?
  criadoEm   DateTime @default(now())

  @@index([usuarioId, lida])
}

model ContatoLog {
  id          String   @id @default(uuid())
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  alvoTipo    String
  alvoId      String
  alvoNome    String
  canal       String
  observacao  String?
  criadoEm    DateTime @default(now())

  @@index([usuarioId, criadoEm])
}

model Conversacao {
  id         String   @id @default(uuid())
  titulo     String
  processoId String?
  processo   Processo? @relation(fields: [processoId], references: [id], onDelete: Cascade)
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  mensagens Mensagem[]

  @@index([usuarioId, processoId])
  @@index([usuarioId, atualizadoEm])
}

model Mensagem {
  id            String   @id @default(uuid())
  conteudo      String
  isUser        Boolean
  criadoEm      DateTime @default(now())

  conversacaoId String
  conversacao   Conversacao @relation(fields: [conversacaoId], references: [id], onDelete: Cascade)
}
