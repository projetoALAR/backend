generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id           String     @id @default(uuid())
  nome         String
  tipo         String     @default("PF")
  cpf          String?    @unique
  cnpj         String?    @unique
  nomeFantasia String?
  rg           String?
  email        String?
  telefone     String?
  endereco     String?
  cidade       String?
  uf           String?
  cep          String?
  observacoes  String?
  criadoEm     DateTime   @default(now())

  processos Processo[]

  @@index([tipo])
}

model Processo {
  id            String    @id @default(uuid())
  numero        String    @unique
  status        String
  descricao     String?
  titulo        String?
  prioridade    String?
  prazo         DateTime?
  tags          Json?
  concluido     Boolean   @default(false)
  /// Cache da sigla DataJud resolvida a partir do número CNJ (ex.: tjsp, trf1)
  tribunalSigla String?
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  responsavelId   String?
  responsavel     Usuario? @relation("ProcessoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  coResponsavelId String?
  coResponsavel   Usuario? @relation("ProcessoCoResponsavel", fields: [coResponsavelId], references: [id], onDelete: SetNull)

  compromissos Compromisso[]
  documentos   Documento[]
  conversas    Conversacao[]
  andamentos   Andamento[]
  comentarios  ProcessoComentario[]
  tarefas      ProcessoTarefa[]

  @@index([clienteId])
  @@index([concluido])
  @@index([prazo])
  @@index([status])
  @@index([atualizadoEm])
  @@index([responsavelId])
  @@index([coResponsavelId])
}

model Andamento {
  id              String   @id @default(uuid())
  processoId      String
  processo        Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  data            DateTime
  descricao       String
  codigoMovimento Int?
  /// Payload bruto do provider (DataJud hoje; outros no futuro)
  origem          Json?
  criadoEm        DateTime @default(now())

  @@index([processoId, data])
}

model ProcessoTarefa {
  id           String    @id @default(uuid())
  processoId   String
  processo     Processo  @relation(fields: [processoId], references: [id], onDelete: Cascade)
  titulo       String
  concluida    Boolean   @default(false)
  ordem        Int       @default(0)
  prazo        DateTime?
  criadoPorId  String?
  criadoPor    Usuario?  @relation("ProcessoTarefaCriador", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@index([processoId, ordem])
  @@index([processoId, concluida])
}

model ProcessoComentario {
  id         String   @id @default(uuid())
  processoId String
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  texto      String
  criadoEm   DateTime @default(now())

  @@index([processoId, criadoEm])
}

model Compromisso {
  id         String   @id @default(uuid())
  titulo     String
  descricao  String?
  dataHora   DateTime
  criadoEm   DateTime @default(now())

  processoId String?
  processo   Processo? @relation(fields: [processoId], references: [id], onDelete: Cascade)

  @@index([dataHora])
  @@index([processoId])
}

model Documento {
  id         String   @id @default(uuid())
  nome       String
  urlArquivo String
  tamanho    Int?
  criadoEm   DateTime @default(now())

  processoId String
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)

  @@index([processoId])
}

model ModeloDocumento {
  id           String   @id @default(uuid())
  nome         String
  categoria    String
  conteudo     String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([categoria])
}

model MembroEquipe {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  cargo     String
  status    String   @default("active")
  criadoEm  DateTime @default(now())

  usuarioId String?  @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([status])
}

enum Role {
  ADMIN
  ADVOGADO
  ASSISTENTE
}

model Usuario {
  id                 String   @id @default(uuid())
  nome               String
  email              String   @unique
  senhaHash          String
  role               Role     @default(ASSISTENTE)
  fotoUrl            String?
  totpSecret         String?
  totpPendingSecret  String?
  totpEnabled        Boolean  @default(false)
  totpRecoveryHashes String[] @default([])
  criadoEm           DateTime @default(now())

  preferencia  Preferencia?
  inbox        InboxItem[]
  contatos     ContatoLog[]
  conversacoes Conversacao[]
  membroEquipe MembroEquipe?
  processosComoResponsavel   Processo[] @relation("ProcessoResponsavel")
  processosComoCoResponsavel Processo[] @relation("ProcessoCoResponsavel")
  comentariosProcesso        ProcessoComentario[]
  tarefasCriadas             ProcessoTarefa[] @relation("ProcessoTarefaCriador")
}

model Preferencia {
  id                 String   @id @default(uuid())
  usuarioId          String   @unique
  usuario            Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nome               String   @default("")
  email              String   @default("")
  fotoUrl            String?
  notificacoes       Json     @default("{\"email\":true,\"push\":true,\"reminders\":true,\"teamUpdates\":true}")
  notificacoesLidas  Json     @default("[]")
  tema               String   @default("light")
  atualizadoEm       DateTime @updatedAt
}

model InboxItem {
  id         String   @id @default(uuid())
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo     String
  corpo      String
  tipo       String   @default("sistema")
  lida       Boolean  @default(false)
  link       String?
  criadoEm   DateTime @default(now())

  @@index([usuarioId, lida])
}

model ContatoLog {
  id          String   @id @default(uuid())
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  alvoTipo    String
  alvoId      String
  alvoNome    String
  canal       String
  observacao  String?
  criadoEm    DateTime @default(now())

  @@index([usuarioId, criadoEm])
}

model Conversacao {
  id         String   @id @default(uuid())
  titulo     String
  processoId String?
  processo   Processo? @relation(fields: [processoId], references: [id], onDelete: Cascade)
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  mensagens Mensagem[]

  @@index([usuarioId, processoId])
  @@index([usuarioId, atualizadoEm])
}

model Mensagem {
  id            String   @id @default(uuid())
  conteudo      String
  isUser        Boolean
  fontes        Json?
  tokensUsados  Int?
  feedback      String?
  criadoEm      DateTime @default(now())

  conversacaoId String
  conversacao   Conversacao @relation(fields: [conversacaoId], references: [id], onDelete: Cascade)

  @@index([conversacaoId, criadoEm])
}

/// Registro imutável de criar/editar/excluir (não apaga com o usuário).
model AuditLog {
  id           String   @id @default(uuid())
  acao         String
  entidade     String
  entidadeId   String
  resumo       String
  usuarioId    String?
  usuarioNome  String?
  usuarioEmail String?
  criadoEm     DateTime @default(now())

  @@index([entidade, criadoEm])
  @@index([usuarioId, criadoEm])
  @@index([entidadeId])
  @@index([criadoEm])
}
