generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- NOSSOS MODELOS ---

model Cliente {
  id        String     @id @default(uuid())
  nome      String
  cpf       String     @unique
  email     String?
  telefone  String?
  criadoEm  DateTime   @default(now())
  
  processos Processo[] 
}

model Processo {
  id           String   @id @default(uuid())
  numero       String   @unique
  status       String   
  descricao    String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  
  clienteId    String
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // Um processo pode ter vários compromissos/prazos (Array)
  compromissos Compromisso[]
  documentos   Documento[]
}

// --- NOVA TABELA ---

model Compromisso {
  id          String   @id @default(uuid())
  titulo      String   // Ex: "Audiência de Custódia", "Reunião Cliente"
  descricao   String?  // Anotações extras
  dataHora    DateTime // Data e hora exata do evento
  criadoEm    DateTime @default(now())

  // A Chave Estrangeira OPCIONAL (note o ponto de interrogação no String?)
  processoId  String?
  processo    Processo? @relation(fields: [processoId], references: [id], onDelete: Cascade)
}

// --- NOVA TABELA DE ANEXOS ---

model Documento {
  id         String   @id @default(uuid())
  nome       String   // Nome original do arquivo (ex: peticao_inicial.pdf)
  urlArquivo String   // O link de onde o arquivo está salvo no Supabase Storage
  tamanho    Int?     // Tamanho do arquivo em bytes (opcional, mas ótimo para UX)
  criadoEm   DateTime @default(now())

  // Chave Estrangeira OBRIGATÓRIA (Todo documento pertence a um processo)
  processoId String
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
}