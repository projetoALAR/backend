# Banco
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# API
PORT=3001
NODE_ENV=development
# Swagger UI em /docs (true força; false desliga; padrão = ligado fora de production)
SWAGGER_ENABLED=

# JWT (obrigatório em produção — não use o default)
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN=7d

# CORS: origens do frontend separadas por vírgula
# Local: http://localhost:3000
# Produção: URL HTTPS do Vercel (ex.: https://alar.vercel.app)
CORS_ORIGINS="http://localhost:3000"
# URL pública do frontend (links em e-mails; fallback = primeira origem CORS)
APP_URL="http://localhost:3000"

# Bootstrap do admin (só cria se a tabela Usuario estiver vazia)
# Senha mínima: 8 caracteres. Sem AUTH_ADMIN_PASSWORD, o admin NÃO é criado.
AUTH_ADMIN_EMAIL="admin@alar.com.br"
AUTH_ADMIN_PASSWORD="troque-esta-senha"
AUTH_ADMIN_NOME="Administrador"

# Cadastro público via POST /v1/auth/register (false = só admin cria usuários)
AUTH_ALLOW_PUBLIC_REGISTER=false

# Documentos (Supabase Storage)
# Bucket "documentos" deve ser PRIVADO — a API gera URLs assinadas (1h)
# Em Windows com antivírus/proxy SSL, o start:dev já usa --use-system-ca (Node 22+)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY="your-supabase-service-or-secret-key"

# Sentry (opcional — sem DSN o app segue normal)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Só em local: libera GET /debug/sentry para validar o painel
SENTRY_ENABLE_TEST_ENDPOINT=false

# Chat IA (opcional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Limite diário de tokens por usuário (padrão: 100000 advogado/assistente, 500000 admin)
CHAT_DAILY_TOKEN_LIMIT=100000
CHAT_DAILY_TOKEN_LIMIT_ADMIN=500000
# Sem OPENAI_API_KEY: chat falha, a menos que CHAT_ALLOW_MOCK=true (prefixo [Modo demonstração])
CHAT_ALLOW_MOCK=false

# SMTP (opcional — sem isso, convites/reset só no inbox;
# em NODE_ENV≠production o link de reset aparece na UI e nos logs)
#
# Teste grátis (Ethereal):
#   npm run smtp:ethereal
# Cole a saída no .env, reinicie a API e use Configurações → Enviar e-mail de teste.
# Alternativa: https://mailtrap.io (plano free)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# DataJud — API pública do CNJ (andamentos processuais)
# ATENÇÃO: uso APENAS não comercial (Termo de Uso do DataJud; Resoluções CNJ 331/2020 e 446/2022).
# Destinado somente a desenvolvimento/teste e demonstração não-comercial.
# Antes de lançamento comercial, substituir por provider licenciado (Jusbrasil/Escavador/Judit.io).
# Termo: https://formularios.cnj.jus.br/wp-content/uploads/2023/05/Termos-de-uso-api-publica-V1.1.pdf
# Obtenha a chave em https://www.cnj.jus.br/sistemas/datajud/api-publica/
# Endpoint base: https://api-publica.datajud.cnj.jus.br/
DATAJUD_API_KEY=
# Após npm run seed:casos-reais, enriquecer descrição/PDFs fictícios (dev only):
#   npm run seed:enriquecer-casos
# Requer OPENAI_API_KEY (ou CHAT_ALLOW_MOCK) + SUPABASE_URL/KEY.

# --- Billing / Asaas ---
# Sandbox: https://sandbox.asaas.com → Integrações → API Key
# Produção: https://www.asaas.com → Integrações → API Key
ASAAS_API_KEY=
# Sandbox (padrão) ou https://api.asaas.com
ASAAS_API_URL=https://api-sandbox.asaas.com
# Token que você configura no painel do webhook Asaas (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=
# Dias de trial antes da 1ª cobrança (padrão 14)
ASAAS_TRIAL_DAYS=14
# Espelha NEXT_PUBLIC_REQUIRE_SUBSCRIPTION do front — bloqueia API sem trial/assinatura
# REQUIRE_SUBSCRIPTION=false
# Webhook URL (configure no Asaas): https://SEU_BACKEND/v1/billing/webhook/asaas
