# Banco
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# API
PORT=3001
NODE_ENV=development

# JWT (obrigatório em produção — não use o default)
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN=7d

# CORS: origens do frontend separadas por vírgula
# Em produção, defina explicitamente (ex.: https://app.seudominio.com)
CORS_ORIGINS="http://localhost:3000"

# Bootstrap do admin (só cria se a tabela Usuario estiver vazia)
# Senha mínima: 8 caracteres. Sem AUTH_ADMIN_PASSWORD, o admin NÃO é criado.
AUTH_ADMIN_EMAIL="admin@alar.com.br"
AUTH_ADMIN_PASSWORD="troque-esta-senha"
AUTH_ADMIN_NOME="Administrador"

# Cadastro público via POST /auth/register (false = só admin cria usuários)
AUTH_ALLOW_PUBLIC_REGISTER=false

# Documentos (Supabase Storage)
# Bucket "documentos" deve ser PRIVADO — a API gera URLs assinadas (1h)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY="your-supabase-service-or-secret-key"

# Sentry (opcional — sem DSN o app segue normal)
SENTRY_DSN=

# Chat IA (opcional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# SMTP (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
